.breathing-circle {
  position: absolute;
  border-radius: 999rpx;
  transition: transform 80ms linear, opacity 300ms ease;
}

.breathing-ring {
  inset: 0;
  border: 4rpx dashed rgba(16, 185, 129, 0.2);
}

.breathing-circle {
  width: 224rpx;
  height: 224rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(14, 165, 233, 0.18));
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  box-shadow: 0 0 40rpx rgba(16, 185, 129, 0.15);
}

.breathing-icon-stack,
.breathing-icon {
  position: relative;
  z-index: 1;
}

.breathing-cue {
  height: 48rpx;
  margin-top: 48rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 48rpx;
  letter-spacing: 1rpx;
}

.breathing-cue-emerald {
  color: #059669;
}

.breathing-cue-amber {
  color: #d97706;
}

.breathing-cue-sky {
  color: #0ea5e9;
}

.breathing-card {
  width: 100%;
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border-radius: 32rpx;
  text-align: left;
  flex-shrink: 0;
  gap: 20rpx;
  border: 1rpx solid rgba(229, 231, 235, 1);
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx -18rpx rgba(15, 23, 42, 0.22);
}

.theme-dark .breathing-card {
  border-color: rgba(30, 41, 59, 0.95);
  background: #0f172a;
  box-shadow: none;
}

.breathing-card-glow {
  position: absolute;
  top: 0;
  right: 0;
  width: 128rpx;
  height: 128rpx;
  background: linear-gradient(225deg, rgba(16, 185, 129, 0.12), rgba(16, 185, 129, 0));
  pointer-events: none;
}

.breathing-card-badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  color: #059669;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.breathing-card-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.theme-dark .breathing-card-main {
  color: #f4f4f5;
}

.breathing-card-marker {
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #10b981;
  flex-shrink: 0;
}

.breathing-card-main-text {
  line-height: 1.5;
}

.breathing-card-body {
  padding-top: 4rpx;
}

.breathing-card-text {
  display: block;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(229, 231, 235, 1);
  background: #f9fafb;
  color: #4b5563;
  font-size: 22rpx;
  line-height: 1.7;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  white-space: pre-line;
}

.theme-dark .breathing-card-text {
  border-color: rgba(30, 41, 59, 0.95);
  background: #020617;
  color: #d4d4d8;
}

.breathing-action-wrap {
  width: 100%;
  padding-bottom: 12rpx;
  flex-shrink: 0;
}

.breathing-confirm {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 300ms ease;
}

.breathing-confirm::after {
  border: none;
}

.breathing-confirm-active {
  background: #10b981;
  color: #ffffff;
  border: 1rpx solid #34d399;
  box-shadow: 0 16rpx 36rpx -22rpx rgba(16, 185, 129, 0.55);
}

.breathing-confirm-disabled {
  color: #9ca3af;
  background: #f3f4f6;
  border: 1rpx solid rgba(229, 231, 235, 1);
}

.theme-dark .breathing-confirm-disabled {
  color: #71717a;
  background: #0f172a;
  border-color: rgba(30, 41, 59, 0.95);
}

.icon-20,
.icon-22,
.icon-24,
.icon-26,
.icon-28,
.icon-42,
.icon-48,
.icon-56 {
  display: block;
}

.icon-20 {
  width: 20rpx;
  height: 20rpx;
}

.icon-22 {
  width: 22rpx;
  height: 22rpx;
}

.icon-24 {
  width: 24rpx;
  height: 24rpx;
}

.icon-26 {
  width: 26rpx;
  height: 26rpx;
}

.icon-28 {
  width: 28rpx;
  height: 28rpx;
}

.icon-44 {
  width: 44rpx;
  height: 44rpx;
}

.icon-42 {
  width: 42rpx;
  height: 42rpx;
}

.icon-48 {
  width: 48rpx;
  height: 48rpx;
}

.icon-56 {
  width: 56rpx;
  height: 56rpx;
}

.report-curve-card {
  padding: 24rpx;
  border-color: rgba(229, 231, 235, 0.6);
}

.theme-dark .report-curve-card,
.theme-dark .report-stat-card,
.theme-dark .report-slider-card {
  border-color: rgba(30, 41, 59, 0.95);
}

.report-curve-head,
.report-curve-title-wrap,
.report-stat-head,
.report-stat-main,
.report-card-head,
.report-badge-tag,
.report-sheet-line,
.report-sheet-label-wrap,
.report-sheet-value-wrap,
.report-sheet-rate-wrap,
.report-sheet-drawdown-wrap,
.report-sheet-streak-wrap,
.report-slider-head,
