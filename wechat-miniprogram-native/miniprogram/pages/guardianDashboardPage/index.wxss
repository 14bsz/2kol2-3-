  background: #0f172a;
  border-color: rgba(30, 41, 59, 0.95);
  box-shadow: 0 18rpx 40rpx -30rpx rgba(0, 0, 0, 0.42);
}

.report-ledger-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding-left: 12rpx;
  gap: 4rpx;
}

.report-ledger-title-row {
  gap: 8rpx;
  align-items: center;
  flex-wrap: wrap;
}

.report-ledger-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 800;
  white-space: normal;
  word-break: break-word;
  line-height: 1.4;
}

.report-ledger-formula,
.report-ledger-time,
.report-ledger-score {
  font-size: 22rpx;
  color: #6b7280;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  line-height: 1.4;
}

.report-ledger-formula {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  background: rgba(16, 185, 129, 0.1);
  color: #059669;
}

.theme-dark .report-ledger-formula,
.theme-dark .report-ledger-time,
.theme-dark .report-ledger-score {
  color: #71717a;
}

.theme-dark .report-ledger-formula {
  color: #34d399;
  background: rgba(6, 78, 59, 0.3);
}

.report-ledger-side {
  flex-shrink: 0;
  margin-left: 16rpx;
  gap: 24rpx;
  align-items: center;
}

.report-ledger-side-metrics {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  text-align: right;
}

.report-ledger-delta {
  font-size: 28rpx;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  line-height: 1.3;
}

.report-ledger-score {
  font-size: 20rpx;
}

.report-ledger-delete {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  min-height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border: 1rpx solid rgba(229, 231, 235, 1);
}

.theme-dark .report-ledger-delete {
  background: rgba(15, 23, 42, 0.96);
  border-color: rgba(30, 41, 59, 0.95);
}

.theme-dark .rescue-button {
  color: #34d399;
  background: rgba(6, 78, 59, 0.18);
  border-color: rgba(6, 95, 70, 0.55);
}

.theme-dark .report-bottom-row {
  color: #71717a;
}

/* ===================================================
   暗色模式补丁：补全所有缺失的 dark theme 文字颜色
   =================================================== */

/* diagnosis-card：标题绿色、正文颜色 */
.theme-dark .diagnosis-title {
  color: #10b981;
}

.theme-dark .diagnosis-text {
  color: #d4d4d8;
}

/* report-advice：正文颜色 */
.theme-dark .report-advice-text {
  color: #d4d4d8;
}

.theme-dark .report-advice-title {
  color: #f4f4f5;
}

/* report-ledger 标题行 */
.theme-dark .report-ledger-title {
  color: #f4f4f5;
}

.theme-dark .report-ledger-score {
  color: #71717a;
}

/* slider 相关标签 */
.theme-dark .report-slider-title {
  color: #d4d4d8;
}

.theme-dark .report-slider-value {
  color: #f59e0b;
}

.theme-dark .report-slider-edge {
  color: #71717a;
}

/* bottom-row 强调数字 */
.theme-dark .bottom-row-strong {
  color: #f4f4f5;
}

/* picker-text 暗色 */
.theme-dark .picker-text {
  color: #e4e4e7;
}

/* help-box 文字 */
.theme-dark .help-text {
  color: #a1a1aa;
}

.theme-dark .help-title-row {
  color: #d4d4d8;
}

/* overlay-title / overlay-text 浅色模式颜色 */
.theme-light .overlay-title {
  color: #111827;
}

.theme-light .overlay-text {
  color: #4b5563;
}

/* report-sheet-divider */
.report-sheet-divider {
  margin: 0 8rpx;
  color: #9ca3af;
}

.theme-dark .report-sheet-divider {
  color: #52525b;
}

/* report-ledger-section 间距 */
.report-ledger-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 4rpx;
}

.report-ledger-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* report-ledger-label 暗色 */
.theme-dark .report-ledger-label {
  color: #a1a1aa;
}

/* ===================================================
   报告Canvas样式
   =================================================== */

.hidden-canvas {
  position: absolute;
  left: -9999rpx;
  top: -9999rpx;
  width: 0;
  height: 0;
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

/* ===================================================
   全息账目明细折叠面板
   =================================================== */

.ledger-accordion-card {
  padding: 0;
}

.ledger-accordion-body {
  padding: 0 0 8rpx;
  border-top: 1rpx solid rgba(229, 231, 235, 0.8);
}

.theme-dark .ledger-accordion-body {
  border-top-color: rgba(30, 41, 59, 0.9);
}

.ledger-accordion-body .ledger-empty {
  margin: 16rpx 24rpx;
}

.ledger-accordion-body .report-ledger-list {
  padding: 12rpx 16rpx 4rpx;
  gap: 12rpx;
}

/* 成功概率大号数字 */
.expect-number-wrap {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
}

.expect-number-big {
  font-size: 58rpx;
  font-weight: 900;
  line-height: 0.92;
  color: #111827;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  letter-spacing: -2rpx;
}

.theme-dark .expect-number-big {
  color: #f8fafc;
}

.expect-number-unit {
  padding-bottom: 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  color: #6b7280;
}

.theme-dark .expect-number-unit {
  color: #a1a1aa;
}

/* 成功概率左右排列行 */
.expect-rate-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}

.expect-rate-row .expect-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.theme-dark .expect-rate-row .expect-label {
  color: #a1a1aa;
}
