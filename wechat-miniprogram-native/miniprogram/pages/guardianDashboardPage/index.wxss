}

.theme-dark .overlay-mask-strong {
  background: rgba(2, 6, 23, 0.98);
}

.overlay-panel {
  width: 100%;
  max-width: 640rpx;
  padding: 56rpx 40rpx;
  border-radius: 36rpx;
  background: #ffffff;
