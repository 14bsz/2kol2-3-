.page-root {
  height: 100vh;
  overflow: hidden;
  background: #0f172a;
}

.theme-light {
  background: #f8fafc;
  color: #111827;
}

.theme-dark {
  background: #020617;
  color: #f4f4f5;
}

.page-shell {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.custom-header,
.panel-header,
.row-between,
.expect-header,
.accordion-header,
.accordion-state-wrap,
.chart-meta-row,
.bottom-row,
.footer-bar,
.report-line,
.slider-box,
.split-title,
.diagnosis-card,
.panel-title-wrap,
.selector-label,
.help-title-row,
.report-advice-title,
.report-tag,
.ledger-label,
.accordion-title-wrap,
.mini-stat-head,
.history-side,
.history-row,
.asset-box,
.picker-box {
  display: flex;
  align-items: center;
}

.custom-header,
.panel-header,
.row-between,
.expect-header,
.accordion-header,
.chart-meta-row,
.bottom-row,
.footer-bar,
.report-line,
.slider-box,
.mini-stat-head,
.history-row,
.ledger-title-row {
  justify-content: space-between;
}

.custom-header {
  box-sizing: border-box;
  padding-left: 32rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.22);
}

.custom-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.theme-light .custom-header {
  background: #ffffff;
}

.theme-dark .custom-header {
  background: rgba(2, 6, 23, 0.9);
  border-bottom-color: rgba(51, 65, 85, 0.8);
}

.header-title-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.header-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #10b981;
  box-shadow: 0 0 18rpx rgba(16, 185, 129, 0.4);
}

.header-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sound-button,
.ghost-button,
.reset-entry,
.rescue-button,
.overlay-primary,
.overlay-secondary,
.breathing-confirm {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.theme-light .sound-button,
.theme-light .ghost-button,
.theme-light .reset-entry,
.theme-light .rescue-button,
.theme-light .overlay-secondary {
  background: #f3f4f6;
}

.theme-dark .sound-button,
.theme-dark .ghost-button,
.theme-dark .reset-entry,
.theme-dark .rescue-button,
.theme-dark .overlay-secondary {
  background: rgba(15, 23, 42, 0.82);
  border-color: rgba(51, 65, 85, 0.88);
}

.sound-button {
  min-height: 68rpx;
  height: 68rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  gap: 6rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sound-button .icon-24 {
  flex-shrink: 0;
}

.header-action-btn {
  min-height: 68rpx;
  height: 68rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  gap: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-action-btn-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.header-action-btn .icon-24 {
  flex-shrink: 0;
}

.header-action-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.header-action-btn-text {
  color: #10b981;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1;
  display: inline-block;
}

.theme-dark .header-action-btn-text {
  color: #10b981;
}

.strategy-help-button {
  min-height: 62rpx;
  padding: 0 20rpx;
  font-size: 18rpx;
}

.sound-button-text {
  color: #9ca3af;
  font-size: 18rpx;
  line-height: 1;
}

.sound-button-text-active {
  color: #10b981;
  font-weight: 800;
}

.header-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.content-shell {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.content-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.content-inner {
  padding: 24rpx 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  box-shadow: 0 20rpx 56rpx -30rpx rgba(15, 23, 42, 0.18);
}

.theme-light .card {
  background: #ffffff;
}

.theme-dark .card {
  background: #0f172a;
  border-color: rgba(30, 41, 59, 0.95);
  box-shadow: 0 26rpx 72rpx -34rpx rgba(0, 0, 0, 0.38);
}

.panel-glow {
  position: absolute;
  right: 0;
  top: 0;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.08), transparent 70%);
}

.panel-title-wrap,
.selector-label,
.split-title,
.help-title-row,
.report-advice-title,
.report-tag,
.ledger-label,
.accordion-title-wrap,
.mini-stat-head,
.diagnosis-card {
  gap: 10rpx;
}

.panel-title,
.accordion-title {
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.panel-meta,
.field-label,
.slider-tip,
.history-time {
  font-size: 20rpx;
  color: #6b7280;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

.ledger-time {
  font-size: 20rpx;
  color: #6b7280;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}
.chart-meta-row,
.report-bottom-row {
  font-size: 20rpx;
  color: #6b7280;
}

.theme-dark .panel-meta,
.theme-dark .field-label,
.theme-dark .slider-tip,
.theme-dark .history-time,
.theme-dark .ledger-time,
.theme-dark .chart-meta-row,
.theme-dark .report-bottom-row {
  color: #a1a1aa;
}

.asset-box,
.picker-box,
.chart-card,
.mini-stat-card,
.history-box,
.help-box,
.report-sheet,
.diagnosis-card,
.breathing-card,
.streak-mini {
  border-radius: 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.78);
}

.asset-box,
.picker-box,
.chart-card,
.mini-stat-card,
.history-box,
.help-box,
.report-sheet,
.diagnosis-card,
.breathing-card {
  background: #f9fafb;
}

.theme-dark .asset-box,
.theme-dark .picker-box,
.theme-dark .chart-card,
.theme-dark .mini-stat-card,
.theme-dark .history-box,
.theme-dark .help-box,
.theme-dark .report-sheet,
.theme-dark .diagnosis-card,
.theme-dark .breathing-card {
  background: rgba(2, 6, 23, 0.88);
  border-color: rgba(30, 41, 59, 0.95);
}

.asset-box {
  margin-top: 18rpx;
  padding: 20rpx;
}

.asset-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.asset-col-right {
  align-items: flex-end;
}

.asset-divider {
  width: 1rpx;
  height: 64rpx;
  margin: 0 20rpx;
  background: rgba(148, 163, 184, 0.32);
}

.expect-divider {
  width: 2rpx;
  height: 32rpx;
  background: #d1d5db;
}

.asset-input {
  width: 100%;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.asset-value,
.stat-number {
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 900;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

.asset-delta {
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 700;
}

.asset-delta-gain {
  color: #10b981;
}

.asset-delta-loss {
  color: #ef4444;
}

.asset-delta-flat {
  color: #6b7280;
}

.theme-dark .asset-delta-flat {
  color: #a1a1aa;
}

.expect-number {
  font-size: 28rpx;
  font-weight: 900;
}

.expect-rate-number {
  font-size: 28rpx;
  font-weight: 900;
}

.asset-value,
.text-green {
  color: #10b981;
}

.text-red {
  color: #ef4444;
}

.text-amber {
  color: #f59e0b;
}

.value-negative {
  color: #ef4444;
}

.selector-grid,
.action-grid,
.forecast-grid,
.mini-stat-grid,
.history-columns,
.streak-grid {
  display: grid;
  gap: 16rpx;
}

.selector-grid,
.forecast-grid,
.mini-stat-grid,
.history-columns,
.streak-grid,
.action-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.selector-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #6b7280;
}

.theme-dark .selector-label {
  color: #a1a1aa;
}

.star-tabs {
  margin-top: 14rpx;
  padding: 8rpx;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
  border-radius: 20rpx;
}

.theme-light .star-tabs {
  background: #f3f4f6;
}

.theme-dark .star-tabs {
  background: #020617;
}

.star-tab {
  height: 56rpx;
  border-radius: 16rpx;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-dark .star-tab {
  color: #71717a;
}

.star-tab-active {
  color: #ffffff !important;
  background: linear-gradient(135deg, #059669, #10b981);
  box-shadow: 0 12rpx 24rpx -12rpx rgba(16, 185, 129, 0.8);
}

.picker-box {
  margin-top: 14rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  justify-content: space-between;
}

.picker-text {
  font-size: 24rpx;
  font-weight: 700;
}

.expect-card-shell {
  padding: 20rpx;
  border-radius: 24rpx;
  border-color: rgba(226, 232, 240, 0.6);
  box-shadow: 0 8rpx 18rpx -12rpx rgba(15, 23, 42, 0.22);
}

.theme-dark .expect-card-shell {
  border-color: rgba(51, 65, 85, 0.72);
  box-shadow: 0 10rpx 22rpx -14rpx rgba(0, 0, 0, 0.44);
}

.expect-header {
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.78);
}

.expect-header-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}

.expect-metrics {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.theme-dark .expect-header {
  border-bottom-color: rgba(30, 41, 59, 0.95);
}

.expect-meta-block {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.expect-meta-block-compact {
  flex-shrink: 0;
}

.expect-meta-block-wide {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.expect-label {
  font-size: 20rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #6b7280;
}

.theme-dark .expect-label {
  color: #a1a1aa;
}

.expect-tag {
  flex-shrink: 0;
  min-height: 36rpx;
  padding: 4rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(209, 213, 219, 0.9);
}

.expect-tag-positive {
  color: #10b981;
  background: #f0fdf4;
  border-color: rgba(16, 185, 129, 0.28);
}

.expect-tag-neutral {
  color: #b45309;
  background: #fffbeb;
  border-color: rgba(245, 158, 11, 0.28);
}

.expect-tag-negative {
  color: #dc2626;
  background: #fef2f2;
  border-color: rgba(239, 68, 68, 0.22);
}

.theme-dark .expect-tag-neutral {
  color: #fbbf24;
  background: rgba(120, 53, 15, 0.3);
  border-color: rgba(245, 158, 11, 0.32);
}

.theme-dark .expect-tag-negative {
  background: rgba(127, 29, 29, 0.28);
  border-color: rgba(248, 113, 113, 0.24);
}

.expect-tag-text {
  font-size: 20rpx;
  line-height: 1;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-weight: 500;
  white-space: nowrap;
}

.expect-number {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
  color: #111827;
  white-space: nowrap;
}

.theme-dark .expect-number {
  color: #f8fafc;
}

.expect-profit-number {
  font-size: 24rpx;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.forecast-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 58rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.forecast-item-success {
  background: rgba(16, 185, 129, 0.1);
  border: 1rpx solid rgba(16, 185, 129, 0.24);
}

.forecast-item-fail {
  background: rgba(239, 68, 68, 0.08);
  border: 1rpx solid rgba(239, 68, 68, 0.22);
}

.forecast-label {
  font-size: 22rpx;
  font-weight: 800;
}
.forecast-value {
  font-size: 24rpx;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-weight: 900;
}

.expect-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.82);
  background: rgba(249, 250, 251, 0.9);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.theme-dark .expect-note {
  border-color: rgba(30, 41, 59, 0.95);
  background: rgba(2, 6, 23, 0.84);
}

.expect-note-value {
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #111827;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

.theme-dark .expect-note-value {
  color: #f4f4f5;
}

.expect-note-text {
  font-size: 20rpx;
  line-height: 1.6;
  color: #6b7280;
}

.theme-dark .expect-note-text {
  color: #a1a1aa;
}

.action-button {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #ffffff;
}

.action-button-fail {
  background: linear-gradient(135deg, #dc2626, #ef4444);
}

.action-button-success {
  background: linear-gradient(135deg, #059669, #10b981);
}

/* 网页端 action-grid gap-3 = 24rpx，小程序对齐 */
.action-grid {
  gap: 24rpx;
}

.accordion-header {
  min-height: 80rpx;
  padding: 0 20rpx;
  width: 100%;
}

.accordion-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: #b45309;
  background: rgba(245, 158, 11, 0.12);
}

.theme-dark .accordion-tag {
  color: #fbbf24;
}

.accordion-state {
  font-size: 18rpx;
  color: #6b7280;
}

.theme-dark .accordion-state {
  color: #a1a1aa;
}

.accordion-body,
.help-box,
.report-card,
.report-sheet,
.report-advice,
.ledger-section,
.chart-card,
.overlay-panel,
.breathing-panel,
.diagnosis-body,
.breathing-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.accordion-body {
  padding-top: 20rpx;
  /* 网页端有分隔线+背景：border-t border-gray-100 bg-gray-50/20 */
  border-top: 1rpx solid rgba(243, 244, 246, 1);
}

.theme-dark .accordion-body {
  border-top-color: rgba(30, 41, 59, 0.95);
}

.mini-stat-card {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 18rpx;
}

.mini-stat-title,
.history-title {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 800;
  word-break: keep-all;
  overflow-wrap: break-word;
}

.diagnosis-title,
.breathing-card-main,
.overlay-title,
.breathing-title {
  font-size: 32rpx;
  font-weight: 800;
}

.mini-stat-title-green,
.history-title-green {
  color: #10b981;
}

.mini-stat-title-indigo,
.history-title-indigo {
  color: #6366f1;
}

/* 头部: 标题 + 实测徽章 */
.mini-stat-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed rgba(148, 163, 184, 0.28);
}

.theme-dark .mini-stat-head {
  border-bottom-color: rgba(51, 65, 85, 0.6);
}

/* 实测率徽章 */
.mini-stat-badge-wrap {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(148, 163, 184, 0.12);
}

.mini-stat-badge-wrap-green {
  background: rgba(16, 185, 129, 0.12);
}

.mini-stat-badge-wrap-indigo {
  background: rgba(99, 102, 241, 0.12);
}

.mini-stat-badge-text {
  font-size: 17rpx;
  font-weight: 800;
  color: #6b7280;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.mini-stat-badge-text-green {
  color: #10b981;
}

.mini-stat-badge-text-indigo {
  color: #6366f1;
}

/* 分割线（头部下方，已通过 border-bottom 实现，此处保留备用） */
.mini-stat-divider {
  display: none;
}

/* 每一行数据行 */
.mini-stat-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
  font-size: 20rpx;
}

.mini-stat-line-label {
  font-size: 20rpx;
  color: #6b7280;
  flex-shrink: 0;
}

.theme-dark .mini-stat-line-label {
  color: #a1a1aa;
}

.mini-stat-line-value {
  font-size: 20rpx;
  font-weight: 700;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  color: #111827;
}

.theme-dark .mini-stat-line-value {
  color: #f4f4f5;
}

.mini-stat-neutral {
  color: #6b7280;
}

.theme-dark .mini-stat-neutral {
  color: #71717a;
}

/* 成/败占比容器 */
.mini-stat-ratio {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.mini-stat-ratio-num {
  font-size: 20rpx;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.mini-stat-ratio-sep {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 2rpx;
}

.theme-dark .mini-stat-ratio-sep {
  color: #52525b;
}

/* 累计损益行（带上边框） */
.mini-stat-line-strong {
  margin-top: 8rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(148, 163, 184, 0.24);
}

.theme-dark .mini-stat-line-strong {
  border-top-color: rgba(51, 65, 85, 0.5);
}

.split-title {
  gap: 10rpx;
  color: #6b7280;
  font-size: 18rpx;
  font-weight: 700;
}

.theme-dark .split-title {
  color: #a1a1aa;
}

.history-column {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 外层 scroll-view 容器 */
.history-scroll {
  flex: 1;
  min-height: 180rpx;
  max-height: 320rpx;
}

.history-box {
  min-height: 180rpx;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-empty,
.ledger-empty {
  min-height: 180rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  border: 1rpx dashed rgba(148, 163, 184, 0.32);
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  font-size: 20rpx;
}

.theme-dark .history-empty,
.theme-dark .ledger-empty {
  color: #71717a;
  border-color: rgba(51, 65, 85, 0.82);
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed rgba(148, 163, 184, 0.2);
}

.history-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.history-meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.history-side {
  gap: 10rpx;
}

.history-main-title,
.ledger-title {
  font-size: 22rpx;
  font-weight: 800;
}

.theme-dark .history-main-title,
.theme-dark .ledger-title {
  color: #f4f4f5;
}

.history-status {
  min-width: 68rpx;
  padding: 6rpx 10rpx;
  border-radius: 12rpx;
  font-size: 16rpx;
  text-align: center;
  font-weight: 700;
}

.history-status-success {
  color: #059669;
  background: rgba(16, 185, 129, 0.12);
}

.history-status-fail {
  color: #dc2626;
  background: rgba(239, 68, 68, 0.12);
}

.history-occurrence {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  font-weight: 800;
  color: #4f46e5;
  background: rgba(99, 102, 241, 0.12);
}

.theme-dark .history-occurrence {
  color: #a5b4fc;
  background: rgba(79, 70, 229, 0.22);
}

.history-delta,
.ledger-delta {
  font-size: 22rpx;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-weight: 800;
}

.trend-box {
  display: flex;
  align-items: center;
  padding: 14rpx;
  gap: 14rpx;
}

.trend-panel-shell {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 8rpx;
}

.trend-label-column {
  width: 72rpx;
  min-width: 72rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.trend-row-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 68rpx;
  border-radius: 18rpx;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.trend-row-label-success {
  color: #10b981;
  background: rgba(16, 185, 129, 0.14);
}

.trend-row-label-fail {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.12);
}

.trend-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.trend-scroll-linked {
  padding: 2rpx 0;
}

.trend-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-width: max-content;
  padding-right: 8rpx;
}

.trend-row {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  gap: 14rpx;
}

.trend-slot {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d1d5db;
  background: #e5e7eb;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 900;
  box-sizing: border-box;
  box-shadow: 0 12rpx 28rpx -24rpx rgba(15, 23, 42, 0.35);
}

.trend-slot-success {
  color: #047857;
  background: #d1fae5;
  border-color: #86efac;
}

.trend-slot-fail {
  color: #dc2626;
  background: #fee2e2;
  border-color: #fca5a5;
}

.trend-slot-empty,
.trend-slot-placeholder {
  color: #6b7280;
  background: #e5e7eb;
  border-color: #d1d5db;
}

.theme-dark .trend-slot {
  border-color: #1f2937;
  background: #020617;
  color: #3f3f46;
}

.theme-dark .trend-slot-success {
  color: #34d399;
  background: rgba(6, 78, 59, 0.4);
  border-color: rgba(6, 95, 70, 0.8);
}

.theme-dark .trend-slot-fail {
  color: #fb7185;
  background: rgba(136, 19, 55, 0.38);
  border-color: rgba(136, 19, 55, 0.7);
}

.theme-dark .trend-slot-empty,
.theme-dark .trend-slot-placeholder {
  color: #71717a;
  background: #020617;
  border-color: #111827;
}

.theme-dark .trend-slot {
  box-shadow: none;
}

.strategy-modal-mask {
  padding: 28rpx;
}

.strategy-modal-panel {
  max-width: 690rpx;
  max-height: 82vh;
  padding: 36rpx 28rpx 28rpx;
  align-items: stretch;
  text-align: left;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 24rpx 72rpx -36rpx rgba(15, 23, 42, 0.35);
}

.theme-dark .strategy-modal-panel {
  border-color: rgba(30, 41, 59, 0.95);
  box-shadow: 0 24rpx 72rpx -36rpx rgba(0, 0, 0, 0.55);
}

.strategy-modal-head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.strategy-modal-title-row {
  font-size: 24rpx;
}

.strategy-modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.theme-dark .strategy-modal-title {
  color: #f4f4f5;
}

.strategy-modal-subtitle {
  font-size: 20rpx;
  line-height: 1.6;
  color: #6b7280;
}

.theme-dark .strategy-modal-subtitle {
  color: #a1a1aa;
}

.strategy-modal-scroll {
  max-height: 760rpx;
  min-height: 420rpx;
}

.strategy-modal-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-right: 8rpx;
}

.strategy-modal-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.86);
  background: rgba(249, 250, 251, 0.9);
}

.theme-dark .strategy-modal-item {
  border-color: rgba(30, 41, 59, 0.95);
  background: rgba(15, 23, 42, 0.82);
}

.strategy-modal-item-index {
  min-width: 34rpx;
  font-size: 20rpx;
  line-height: 1.7;
  font-weight: 900;
  color: #10b981;
}

.strategy-modal-item-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.7;
  color: #374151;
  word-break: break-word;
  white-space: pre-wrap;
}

.theme-dark .strategy-modal-item-text {
  color: #d4d4d8;
}

.strategy-modal-close {
  width: 100%;
}

.help-title-row {
  font-size: 18rpx;
  font-weight: 700;
}

.diagnosis-text {
  font-size: 22rpx;
  line-height: 1.7;
}

.help-text,
.breathing-card-text,
.overlay-text,
.breathing-text,
.report-advice-text {
  font-size: 28rpx;
  line-height: 1.7;
}

.bottom-row {
  padding-top: 16rpx;
  padding-bottom: 6rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.78);
}

.theme-dark .bottom-row {
  border-top-color: rgba(30, 41, 59, 0.95);
}

.bottom-row-strong {
  font-weight: 900;
}

.bottom-row-text {
  font-size: 22rpx;
  line-height: 1.5;
}

.reset-entry {
  min-height: 68rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  gap: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.reset-entry text {
  line-height: 1;
}

.footer-bar {
  min-height: 128rpx;
  padding: 0 48rpx calc(env(safe-area-inset-bottom) + 0rpx);
  border-top: 1rpx solid rgba(148, 163, 184, 0.22);
}

.theme-light .footer-bar {
  background: #ffffff;
}

.theme-dark .footer-bar {
  background: #020617;
  border-top-color: rgba(30, 41, 59, 0.95);
}

.footer-button {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 600;
}

.theme-dark .footer-button {
  color: #71717a;
}

.footer-button-active {
  color: #10b981 !important;
  font-weight: 900;
}

.footer-button-theme-light {
  color: #4f46e5;
}

.footer-button-theme-dark {
  color: #f59e0b;
}

/* 点击反馈：轻微缩放 + 透明度，复刻网页端 active:scale-95 效果，无黑色背景 */
.footer-button-hover {
  opacity: 0.65;
  transform: scale(0.95);
}

.accordion-header-hover {
  opacity: 0.75;
}

/* action-button（失败/成功）：scale-95 压缩反馈 */
.action-button-hover {
  opacity: 0.82;
  transform: scale(0.95);
}

/* 星级tab、走势格子、小按钮：轻微淡出 */
.star-tab-hover,
.trend-slot-hover,
.ghost-button-hover,
.reset-entry-hover,
.ledger-delete-hover {
  opacity: 0.6;
}

.report-badge {
  position: absolute;
  top: 2rpx;
  right: 22rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #ef4444;
  box-shadow: 0 0 0 8rpx rgba(239, 68, 68, 0.16);
}

.chart-card {
  margin-top: 16rpx;
  padding: 18rpx;
}

.trend-canvas {
